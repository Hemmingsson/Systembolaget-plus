{
  "name": "Systembolaget+",
  "version": "1.1.1",
  "manifest_version": 3,
  "description": "Adds Vivino, Untappd, and Distiller ratings to Systembolaget product pages.",
  "homepage_url": "https://github.com/Hemmingsson/Systembolaget-plus",
  "author": "Mattias Hemmingsson",
  "permissions": [
    "storage"
  ],
  "default_locale": "en",
  "icons": {
    "16": "assets/16.png",
    "48": "assets/48.png",
    "128": "assets/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.systembolaget.se/*"
      ],
      "css": [
        "styles/styles.css"
      ],
      "js": [
        "scripts/extension.js"
      ]
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "minimum_chrome_version": "109",
  "host_permissions": [
    "https://www.vivino.com/*",
    "https://untappd.com/*",
    "https://distiller.com/*"
  ]
}
